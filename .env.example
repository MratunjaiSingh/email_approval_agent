# provider:model  (langchain init_chat_model format)
# examples: groq:openai/gpt-oss-120b | google_genai:<model> | openai:<model>
LLM_MODEL=groq:openai/gpt-oss-120b
# API key for your provider, e.g.
GROQ_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# true = emails are only logged, never sent
DRY_RUN=true

# Gmail: use an App Password (2-Step Verification must be on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

CHECKPOINT_DB=checkpoints.db
